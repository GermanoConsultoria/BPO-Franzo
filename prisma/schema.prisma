generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String    @id @default(uuid())
  nome      String
  dt_insert DateTime  @default(now())

  equipes   Equipe[]
  usuarios  Usuario[]

  @@map("workspace")
}

// ==========================================
// EQUIPES — cada equipe é o financeiro isolado de um cliente
// ==========================================

model Equipe {
  id           String          @id @default(uuid())
  nome         String
  descricao    String?
  whatsapp     String?
  workspace_id String
  dt_insert    DateTime        @default(now())
  dt_update    DateTime        @default(now()) @updatedAt

  workspace    Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  membros      EquipeUsuario[]
  planoContas  PlanoContas[]
  lancamentos  LancamentoFinanceiro[]

  @@map("equipe")
}

model EquipeUsuario {
  equipe_id  String
  usuario_id String
  role       String   @default("MEMBER")
  dt_insert  DateTime @default(now())

  equipe     Equipe   @relation(fields: [equipe_id], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([equipe_id, usuario_id])
  @@map("equipe_usuario")
}

// ==========================================
// USUÁRIOS
// role: ADMIN (opera o sistema, acesso total) | PERSONALIZADO (permissões
// individuais, ver UsuarioPermissao) | CLIENTE (vê só o financeiro da própria equipe)
// ==========================================

model Usuario {
  id                 String            @id @default(uuid())
  nome               String
  email              String            @unique
  senha              String
  dt_insert          DateTime          @default(now())
  ativo              Boolean           @default(true)
  cargo              String?
  dt_update          DateTime          @default(now()) @updatedAt
  imagem             String?
  role               String            @default("CLIENTE")
  workspace_id       String

  equipes            EquipeUsuario[]
  permissoes         UsuarioPermissao[]
  workspace          Workspace         @relation(fields: [workspace_id], references: [id], map: "Usuario_workspace_id_fkey")

  @@map("usuario")
}

// Permissões individuais de um usuário com role = PERSONALIZADO.
// Chaves válidas ficam centralizadas em lib/permissoes.ts.
model UsuarioPermissao {
  usuario_id String
  chave      String
  dt_insert  DateTime @default(now())

  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, chave])
  @@map("usuario_permissao")
}

// ==========================================
// MÓDULO FINANCEIRO
// ==========================================

model PlanoContas {
  id           String                 @id @default(uuid())
  equipe_id    String
  tipo         TipoLancamento
  nome         String
  ativo        Boolean                @default(true)
  dt_insert    DateTime               @default(now())
  dt_update    DateTime               @default(now()) @updatedAt

  equipe       Equipe                 @relation(fields: [equipe_id], references: [id], onDelete: Cascade)
  lancamentos  LancamentoFinanceiro[]

  @@map("plano_contas")
}

model LancamentoFinanceiro {
  id                String                 @id @default(uuid())
  equipe_id         String
  tipo              TipoLancamento
  descricao         String
  beneficiario      String?
  valor             Decimal                @db.Decimal(15, 2)
  dt_vencimento     DateTime
  dt_pagamento      DateTime?
  numero_documento  String?
  plano_contas_id   String
  status            StatusLancamento       @default(PENDENTE)
  recorrencia       Recorrencia            @default(NAO)
  numero_parcelas   Int?
  parcela_atual     Int?
  grupo_parcela_id  String?
  lancamento_pai_id String?
  dt_insert         DateTime               @default(now())
  dt_update         DateTime               @default(now()) @updatedAt

  equipe            Equipe                 @relation(fields: [equipe_id], references: [id], onDelete: Cascade)
  plano_contas      PlanoContas            @relation(fields: [plano_contas_id], references: [id])
  lancamento_pai    LancamentoFinanceiro?  @relation("Parcelas", fields: [lancamento_pai_id], references: [id], onDelete: SetNull)
  parcelas          LancamentoFinanceiro[] @relation("Parcelas")
  anexos            AnexoFinanceiro[]

  @@map("lancamento_financeiro")
}

model AnexoFinanceiro {
  id            String               @id @default(uuid())
  lancamento_id String
  nome          String
  url           String
  key           String
  tamanho       Int
  dt_upload     DateTime             @default(now())

  lancamento    LancamentoFinanceiro @relation(fields: [lancamento_id], references: [id], onDelete: Cascade)

  @@map("anexo_financeiro")
}

enum Recorrencia {
  NAO
  DIARIAMENTE
  SEMANALMENTE
  MENSALMENTE
}

enum TipoLancamento {
  DESPESA
  RECEITA
}

enum StatusLancamento {
  PENDENTE
  PAGO
  CANCELADO
}
